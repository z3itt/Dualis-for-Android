<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Dualis" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@color/dualis_background</item>
        <item name="android:navigationBarColor">@color/dualis_background</item>
        <item name="android:windowBackground">@color/dualis_background</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:isLightTheme">true</item>
    </style>

    <style name="Theme.Dualis.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/dualis_splash</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_mark</item>
        <item name="postSplashScreenTheme">@style/Theme.Dualis</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:statusBarColor">@color/dualis_splash</item>
        <item name="android:navigationBarColor">@color/dualis_splash</item>
    </style>
</resources>
